# ==============================================================================
# Meeting.ai Clone - Environment Configuration (BYOK: Bring Your Own Key)
# ==============================================================================

# Port server lokal
PORT=3000
NODE_ENV=development

# AI Provider: '9router' atau 'gemini'
AI_PROVIDER=9router

# 9Router Local Configuration
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=your_9router_key_here
ROUTER_MODEL=ag/gemini-3.8-flash-high

# Google Gemini API Key (Fallback direct)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Database path (SQLite lokal di folder data)
DATABASE_URL=file:./data/db/meetingai.sqlite

# Lokasi penyimpanan rekaman audio mentah & chunks
STORAGE_RECORDINGS_PATH=./data/recordings

# Meeting Bot Setting (Playwright)
BOT_DISPLAY_NAME=AI Meeting Note Taker
HEADLESS_BOT=true
