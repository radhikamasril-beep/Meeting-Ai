# ==============================================================================
# Meeting.ai Clone - Environment Configuration (BYOK: Bring Your Own Key)
# ==============================================================================

# Port server lokal
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Untuk STT multi-speaker + ringkasan + task extraction)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini default (gemini-2.5-flash sangat cepat dan akurat untuk audio rapat)
GEMINI_MODEL=gemini-2.5-flash

# Database path (SQLite lokal di folder data)
DATABASE_URL=file:./data/db/meetingai.sqlite

# Lokasi penyimpanan rekaman audio mentah & chunks
STORAGE_RECORDINGS_PATH=./data/recordings

# Meeting Bot Setting (Playwright)
BOT_DISPLAY_NAME=AI Meeting Note Taker
HEADLESS_BOT=true
